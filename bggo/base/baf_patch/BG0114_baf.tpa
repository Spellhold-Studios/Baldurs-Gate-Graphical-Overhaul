ACTION_IF FILE_EXISTS_IN_GAME ~%are2%.bcs~ BEGIN
	EXTEND_BOTTOM ~%are2%.bcs~ ~.../%MOD_FOLDER%/inlined_BG0114.baf~ EVAL
		
END ELSE BEGIN
	COPY ~.../%MOD_FOLDER%/inlined_BG0114.baf~ ~%workspace%/bif/temp/%are2%.baf~
	COMPILE EVAL ~%workspace%/bif/temp/%are2%.baf~
END
	