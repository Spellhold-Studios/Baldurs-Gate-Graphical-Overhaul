		fj_door_closed_vert_1  = 4388 + (1444 << 16)
		fj_door_closed_vert_2  = 4388 + (1398 << 16)
		fj_door_closed_vert_3  = 4383 + (1390 << 16)
		fj_door_closed_vert_4  = 4374 + (1379 << 16)
		fj_door_closed_vert_5  = 4367 + (1376 << 16)
		fj_door_closed_vert_6  = 4358 + (1377 << 16)

		fj_cell_open_vert_0    = 3 + (119 << 16)
		fj_cell_open_vert_1    = 3 + (120 << 16)
		fj_cell_open_vert_2    = 6 + (120 << 16)

		fj_cell_closed_vert_0  = 5 + (119 << 16)
