PATCH_IF travel_trigger_found = 0 BEGIN
	LPF fj_are_structure
		INT_VAR
		fj_type         = 2    //travel
		fj_box_left     = 4358
		fj_box_top      = 1376
		fj_box_right    = 4388
		fj_box_bottom   = 1444
		fj_cursor_idx   = 30
		fj_alt_x		= 4368
		fj_alt_y		= 1447
		fj_flags        = BIT10 + BIT11  //BIT10 ativation point BIT11 door connected
		fj_vertex_0  = 4358 + (1422 << 16)
