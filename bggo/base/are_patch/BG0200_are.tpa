	LPF fj_are_structure
		INT_VAR
		fj_loc_x       = 4340
		fj_loc_y       = 1467
		fj_orientation = 2
		STR_VAR
		fj_structure_type = entrance
		fj_name           = bggo_Exit0114b
	END
END
