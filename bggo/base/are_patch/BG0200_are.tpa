// map note Oberons Estate	
INNER_ACTION BEGIN
	COPY_EXISTING - ~%CentralBaldursGate%.are~ ~override~
		GET_OFFSET_ARRAY mapnotes 0xc4 4 0xc8 4 0 0 0x34
		SET dialog_string = 0
		PHP_EACH mapnotes AS i => off BEGIN
			READ_SHORT off x_coord
			READ_SHORT off + 0x02 y_coord
			PATCH_IF x_coord = 3446 AND y_coord = 176 BEGIN
				READ_LONG off + 0x04 dialog_string
			END
		END
END

PATCH_IF dialog_string > 0 BEGIN
	LPF fj_are_structure
	INT_VAR
		fj_loc_x = 3346
		fj_loc_y = 3127
		fj_note_strref = ~%dialog_string%~
	STR_VAR
		fj_structure_type   = note
	END
END

