		fj_door_closed_vert_2  = 3030 + (1160 << 16)
		fj_door_closed_vert_3  = 3025 + (1191 << 16)
		fj_cell_open_vert_0    = 186 + (74 << 16)
		fj_cell_open_vert_1    = 186 + (75 << 16)
		fj_cell_open_vert_2    = 187 + (75 << 16)
		fj_cell_open_vert_3    = 188 + (75 << 16)
		fj_cell_closed_vert_0  = 186 + (72 << 16)
		fj_cell_closed_vert_1  = 186 + (73 << 16)
		fj_cell_closed_vert_2  = 186 + (74 << 16)
		STR_VAR
		fj_travel_trigger      = bggo_Door0014
		fj_structure_type      = door
		fj_name                = EVAL ~%existing_door_name%~
		fj_door_wed_id         = DOOR02
		fj_door_script		   = EVAL ~%door_script%~
	END
END


