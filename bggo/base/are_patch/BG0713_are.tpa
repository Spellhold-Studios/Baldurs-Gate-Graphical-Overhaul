SPRINT identical_area "BG0167"

PATCH_IF FILE_EXISTS ~%MOD_FOLDER%/base/are_patch/%identical_area%_are.tpa~ BEGIN // add animation for braziers, candles ...
	PATCH_INCLUDE ~%MOD_FOLDER%/base/are_patch/%identical_area%_are.tpa~
END

////////////////////////////////////////////
// trigger to leave to BG0800
////////////////////////////////////////////
LPF fj_are_structure
    INT_VAR
    fj_type         = 2    //travel
    fj_box_left     = 413
    fj_box_top      = 336
    fj_box_right    = 537
    fj_box_bottom   = 463
	fj_flags        = BIT8 //BIT8 deativated
    fj_cursor_idx   = 30   //door
	fj_vertex_0  = 491 + (336 << 16)
	fj_vertex_1  = 537 + (405 << 16)
	fj_vertex_2  = 463 + (463 << 16)
	fj_vertex_3  = 413 + (413 << 16)
    STR_VAR
    fj_structure_type   = region
    fj_name             = bggo_BG0800
    fj_destination_area = EVAL ~%EBaldursGate%~
    fj_destination_name = Exit0713
END

LPF CreateHouseAreaScript
	STR_VAR
		area_name_house 	= EVAL ~%CentralBaldursGate_House5_L1%~
		area_name_1 		= EVAL ~%CentralBaldursGate%~
		area_name_2 		= EVAL ~%EBaldursGate%~
END