
//Add candles and torches
PATCH_DEFINE_ARRAY x_coord BEGIN 362 384 541 669 933 1027 950 355 1014 1297 1026 1292 742 893 548 803 END
PATCH_DEFINE_ARRAY y_coord BEGIN 53  314 348 346 483 531  360 546 219  190  531  667  529 766 746 415 END
PATCH_PHP_EACH x_coord AS index => x BEGIN
	LPM ~DELETE_EXISTING_ANIMATIONS~
	LPF fj_are_structure
	INT_VAR
		fj_loc_x = $x_coord("%index%")
		fj_loc_y = $y_coord("%index%")
		fj_schedule =  0b111111111111111111111111 //Hours 0.00 - 24.00
		fj_flags = 0b00000000000000000001000001100011	// Visible, blend colours, not covered by wall, don't remove in combat
		STR_VAR
		fj_structure_type = animation
		fj_name = FLMS
		fj_bam_resref = FLMS //bgrd
	END
END
LPM ~CLEAR_ARRAY~

//Add candles and torches
PATCH_DEFINE_ARRAY x_coord BEGIN 566 667 763 882 1094 1235 195 END
PATCH_DEFINE_ARRAY y_coord BEGIN 582 478 724 603 744  407  327 END
PATCH_PHP_EACH x_coord AS index => x BEGIN
	LPM ~DELETE_EXISTING_ANIMATIONS~
	LPF fj_are_structure
	INT_VAR
		fj_loc_x = $x_coord("%index%")
		fj_loc_y = $y_coord("%index%")
		fj_schedule =  0b111111111111111111111111 //Hours 0.00 - 24.00
		fj_flags = 0b00000000000000000001000001100011	// Visible, blend colours, not covered by wall, don't remove in combat
		STR_VAR
		fj_structure_type = animation
		fj_name = FLAME2N
		fj_bam_resref = FLAME2N //bgrd
	END
END
LPM ~CLEAR_ARRAY~

//////////////////////////////
// Door0112
//////////////////////////////

// delete old one
GET_OFFSET_ARRAY triggers ARE_V10_REGIONS
PHP_EACH triggers AS i => off BEGIN
	READ_ASCII off triggername (32) NULL
	PATCH_IF ~%triggername%~ STR_EQ ~Door0112~ BEGIN
		LPF fj_are_structure
			INT_VAR fj_delete_mode = i
			STR_VAR fj_structure_type = region
		END 
	END
END
// install new one
LPF fj_are_structure
	INT_VAR
	fj_type         = 2    //travel
	fj_box_left     = 66
	fj_box_top      = 298
	fj_box_right    = 141
	fj_box_bottom   = 351
	fj_cursor_idx   = 30   //door
	fj_flags        = 0b000010000000100
	fj_alt_x		= 136
	fj_alt_y		= 300
	fj_vertex_0  = 102 + (298 << 16)
	fj_vertex_1  = 141 + (319 << 16)
	fj_vertex_2  = 102 + (351 << 16)
	fj_vertex_3  = 66  + (331 << 16)
	STR_VAR
	fj_structure_type   = region
	fj_name             = Door0112
	fj_destination_area = EVAL ~%BaldursGate_Undercellars%~
	fj_destination_name = Exit0114
END

GET_OFFSET_ARRAY entrances ARE_V10_ENTRANCES
PHP_EACH entrances AS i => off BEGIN
	READ_ASCII off entrancename (32) NULL
	PATCH_IF ~%entrancename%~ STR_EQ ~EXIT0112~ BEGIN
		WRITE_SHORT off + 0x20 179
		WRITE_SHORT off + 0x22 261
	END
END

