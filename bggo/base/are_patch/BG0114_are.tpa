	fj_alt_y		= 460
	fj_vertex_0  = 265 + (498 << 16)
	fj_vertex_1  = 342 + (544 << 16)
	fj_vertex_2  = 342 + (477 << 16)
	fj_vertex_3  = 265 + (436 << 16)
	STR_VAR
	fj_structure_type   = region
	fj_name             = bggo_BG0300
	fj_destination_area = EVAL ~%NEBaldursGate%~
