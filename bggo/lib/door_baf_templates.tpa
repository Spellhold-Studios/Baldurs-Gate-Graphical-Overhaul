<<<<<<<< .../%MOD_FOLDER%/inlined_door_open_close.baf

%global_unlock_door%

IF
	Global("BGGO_opened_%door_name%","GLOBAL",0)
THEN
	RESPONSE #100
	CloseDoor("%door_name%")
	Continue()
END
IF
	Global("BGGO_opened_%door_name%","GLOBAL",1)
THEN
	RESPONSE #100
	OpenDoor("%door_name%")
	Continue()
END

