<<<<<<<< .../%MOD_FOLDER%/inlined_door_script.baf

%set_unlock_door%

IF
	Clicked([ANYONE])
    OpenState("%door_name%",TRUE)
	Global("BGGO_unlocked_%door_name%","GLOBAL",1)
//    Opened([ANYONE])
THEN
    RESPONSE #100
		SetGlobal("BGGO_opened_%door_name%","GLOBAL",1)
END

IF
	Clicked([ANYONE])
    OpenState("%door_name%",FALSE)
	Global("BGGO_unlocked_%door_name%","GLOBAL",1)
//	Closed([ANYONE])
THEN
    RESPONSE #100
		SetGlobal("BGGO_opened_%door_name%","GLOBAL",0)
END

%door_click%

